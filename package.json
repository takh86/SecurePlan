{
  "name": "secureplan",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Engineering Case Study \u00b7 THM Praxisphase \u00b7 B2B-SaaS Workforce Planning",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "node scripts/verified-test-command.mjs e2e",
    "test:scripts": "node scripts/verified-test-command.mjs scripts",
    "db:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d --wait postgres mailpit",
    "db:down": "docker compose --env-file .env -f infra/docker/compose.yaml stop postgres mailpit",
    "stack:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d --build --wait",
    "stack:down": "docker compose --env-file .env -f infra/docker/compose.yaml down",
    "stack:ps": "docker compose --env-file .env -f infra/docker/compose.yaml ps",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:verify": "node --env-file=.env scripts/verify-db.mjs",
    "start:backend": "node --env-file=.env apps/backend/dist/main.js",
    "check:replacement-api": "node scripts/export-replacement-openapi.mjs --check",
    "check:public": "node scripts/check-public.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
