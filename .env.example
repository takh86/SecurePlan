# Synthetic local development only. Replace all credentials for staging.
DATABASE_URL=postgresql://secureplan:secureplan_local@127.0.0.1:5432/secureplan
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Absolute path to the generated password denylist (see scripts/build-password-denylist.mjs).
# Required at startup; the file is intentionally not stored in Git.
# SECUREPLAN_PASSWORD_DENYLIST_PATH=
# Required at backend startup; private 32-byte HMAC key as 64 hex chars.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store in .env / protected deployment secrets, never commit a real key.
# SECUREPLAN_LOGIN_HMAC_KEY=
