{
  "openapi": "3.0.3",
  "info": {
    "title": "SecurePlan SP19 Administrative Read API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/admin/work-queue": {
      "get": {
        "summary": "Read administrative work queue",
        "description": "COMPANY_ADMIN only. Open normalized cases; filters apply before pagination.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "monthStart",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-01$"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CANCELLATION_REQUEST",
                "REPLACEMENT_NEED"
              ]
            }
          },
          {
            "name": "offerPresence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "WITH_ELIGIBLE",
                "WITHOUT_ELIGIBLE"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "maximum": 90071992547409
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "dutyDate"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private, no-store authorized response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Role forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or concealed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cancellation-requests/{requestId}": {
      "get": {
        "summary": "Read cancellation",
        "description": "COMPANY_ADMIN within tenant or owner EMPLOYEE.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private, no-store authorized response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Role forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or concealed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/replacement-needs/{needId}": {
      "get": {
        "summary": "Read replacement need",
        "description": "COMPANY_ADMIN within tenant or contextually eligible EMPLOYEE.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "needId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private, no-store authorized response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplacementNeed"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Role forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or concealed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/replacement-needs/{needId}/offers": {
      "get": {
        "summary": "Read administrative offer context",
        "description": "COMPANY_ADMIN only. Context, count and page use one database statement snapshot. Eligibility concerns current criteria for submitting a new offer only.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "needId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "SELECTED",
                "NOT_SELECTED",
                "INVALIDATED",
                "WITHDRAWN"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "maximum": 90071992547409
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private, no-store authorized response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOffersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Role forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or concealed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-secureplan_session"
      }
    },
    "schemas": {
      "EmployeeIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "employeeCode",
          "firstName",
          "lastName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "DutySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dutyDate",
          "shiftKind",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dutyDate": {
            "type": "string",
            "format": "date"
          },
          "shiftKind": {
            "type": "string",
            "enum": [
              "DAY",
              "NIGHT"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "NeedSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "resolvedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "OPEN_UNFILLED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assignmentId",
          "employee",
          "duty",
          "status",
          "createdAt",
          "decidedAt",
          "replacementNeed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "employee": {
            "$ref": "#/components/schemas/EmployeeIdentity"
          },
          "duty": {
            "$ref": "#/components/schemas/DutySummary"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "WITHDRAWN",
              "REJECTED",
              "APPROVED",
              "OBSOLETE"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "replacementNeed": {
            "$ref": "#/components/schemas/NeedSummary"
          }
        }
      },
      "ReplacementNeed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cancellationRequestId",
          "duty",
          "status",
          "resolvedAt",
          "openOfferCount",
          "project",
          "timeZone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cancellationRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "duty": {
            "$ref": "#/components/schemas/DutySummary"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "OPEN_UNFILLED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "openOfferCount": {
            "type": "integer",
            "minimum": 0
          },
          "project": {
            "$ref": "#/components/schemas/ProjectSummary"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "QueueItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "cancellationRequestId",
          "replacementNeedId",
          "duty",
          "requestingEmployee",
          "cancellationStatus",
          "replacementNeedStatus",
          "openOfferCount",
          "eligibleOpenOfferCount",
          "project",
          "monthStart",
          "timeZone",
          "createdAt"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CANCELLATION_REQUEST",
              "REPLACEMENT_NEED"
            ]
          },
          "cancellationRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "replacementNeedId": {
            "type": "string",
            "format": "uuid"
          },
          "duty": {
            "$ref": "#/components/schemas/DutySummary"
          },
          "requestingEmployee": {
            "$ref": "#/components/schemas/EmployeeIdentity"
          },
          "cancellationStatus": {
            "type": "string",
            "enum": [
              "OPEN",
              "WITHDRAWN",
              "REJECTED",
              "APPROVED",
              "OBSOLETE"
            ]
          },
          "replacementNeedStatus": {
            "type": "string",
            "enum": [
              "OPEN",
              "OPEN_UNFILLED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "openOfferCount": {
            "type": "integer",
            "minimum": 0
          },
          "eligibleOpenOfferCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Count meeting current SP18 new-offer submission criteria; not selection authorization."
          },
          "project": {
            "$ref": "#/components/schemas/ProjectSummary"
          },
          "monthStart": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QueueResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pagination",
          "evaluatedAt"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminOffer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "needId",
          "employee",
          "status",
          "createdAt",
          "decidedAt",
          "reviewEligibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "needId": {
            "type": "string",
            "format": "uuid"
          },
          "employee": {
            "$ref": "#/components/schemas/EmployeeIdentity"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "SELECTED",
              "NOT_SELECTED",
              "INVALIDATED",
              "WITHDRAWN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reviewEligibility": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "INELIGIBLE",
              "NOT_APPLICABLE"
            ],
            "description": "Current SP18 criteria for submitting a new voluntary offer only; not administrative selection or assignment suitability."
          }
        }
      },
      "AdminOfferContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cancellation",
          "need",
          "monthStart",
          "dutyRemoved",
          "originalAssignmentActive",
          "eligibleOpenOfferCount",
          "evaluatedAt"
        ],
        "properties": {
          "cancellation": {
            "$ref": "#/components/schemas/Cancellation"
          },
          "need": {
            "$ref": "#/components/schemas/ReplacementNeed"
          },
          "monthStart": {
            "type": "string",
            "format": "date"
          },
          "dutyRemoved": {
            "type": "boolean"
          },
          "originalAssignmentActive": {
            "type": "boolean"
          },
          "eligibleOpenOfferCount": {
            "type": "integer",
            "minimum": 0
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminOffersResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pagination",
          "context"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminOffer"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "context": {
            "$ref": "#/components/schemas/AdminOfferContext"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "properties": {
          "pointer": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    }
  }
}
