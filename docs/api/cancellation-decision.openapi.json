  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-secureplan_session",
        "description": "Opaque server-side session; company and actor identities are established by the server, never by the request body."
      }
    },
    "schemas": {
      "RejectDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "const": "REJECT"
          },
          "replacementOfferId": {
            "type": "null"
          }
        }
      },
      "ApproveDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "expectedDutyVersion"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "const": "APPROVE"
          },
          "expectedDutyVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "replacementOfferId": {
            "type": "null"
          }
        }
      },
      "DecisionRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RejectDecision"
          },
          {
            "$ref": "#/components/schemas/ApproveDecision"
          }
        ]
      },
      "Employee": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "employeeCode",
          "firstName",
          "lastName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "Duty": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dutyDate",
          "shiftKind",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dutyDate": {
            "type": "string",
            "format": "date"
          },
          "shiftKind": {
            "type": "string",
            "enum": [
              "DAY",
              "NIGHT"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdatedDuty": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dutyDate",
          "shiftKind",
          "startsAt",
          "endsAt",
          "concurrencyVersion"
        ],
        "properties": {
          "id": {
