{
  "openapi": "3.1.0",
  "info": {
    "title": "SecurePlan employee replacement offers",
    "version": "SP18-P2",
    "description": "Approved employee surface of issue #34. An offer is voluntary and does not assign the employee. No candidate list or administrative decision endpoints. Work-items keeps both collection keys; loaded older clients require a coordinated refresh before enabling writes."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/me/replacement-needs": {
      "get": {
        "operationId": "listEligibleReplacementNeeds",
        "parameters": [
          {
            "name": "monthStart",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-01$"
            },
            "description": "Real civil first day, years 0001 through 9999."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authenticated employee result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeedPage"
                }
              }
            }
          },
          "400": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "401": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "403": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "404": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "409": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "500": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          }
        }
      }
    },
    "/api/v1/replacement-needs/{needId}": {
      "parameters": [
        {
          "name": "needId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getEligibleReplacementNeed",
        "responses": {
          "200": {
            "description": "Current authenticated employee result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Need"
                }
              }
            }
          },
          "400": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "401": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "403": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "404": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "409": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "500": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          }
        }
      }
    },
    "/api/v1/replacement-needs/{needId}/offers": {
      "parameters": [
        {
          "name": "needId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createReplacementOffer",
        "x-bodyless": true,
        "description": "EMPLOYEE only. No request body or query. Current identity is server-derived. Same-key retry returns the current owned result, including terminal status, with Idempotency-Replayed: true.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Current authenticated employee result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Offer"
                }
              }
            }
          },
          "400": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "401": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "403": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "404": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "409": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "500": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          }
        }
      }
    },
    "/api/v1/me/work-items": {
      "get": {
        "operationId": "getOwnWorkItems",
        "parameters": [
          {
            "name": "monthStart",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-01$"
            },
            "description": "Real civil first day, years 0001 through 9999."
          }
        ],
        "responses": {
          "200": {
            "description": "Current authenticated employee result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItems"
                }
              }
            }
          },
          "400": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "401": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "403": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "404": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "409": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          },
          "500": {
            "description": "Existing RFC 9457 problem contract; private, no-store; resource concealment applies."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-secureplan_session"
      }
    },
    "schemas": {
      "Employee": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "employeeCode",
          "firstName",
          "lastName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "Duty": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dutyDate",
          "shiftKind",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dutyDate": {
            "type": "string",
            "format": "date"
          },
          "shiftKind": {
            "enum": [
              "DAY",
              "NIGHT"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "needId",
          "employee",
          "status",
          "createdAt",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "needId": {
            "type": "string",
            "format": "uuid"
          },
          "employee": {
            "$ref": "#/components/schemas/Employee"
          },
          "status": {
            "enum": [
              "OPEN",
              "SELECTED",
              "NOT_SELECTED",
              "INVALIDATED",
              "WITHDRAWN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "decidedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "OPEN"
                }
              }
            },
            "then": {
              "properties": {
                "decidedAt": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "decidedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              }
            }
          }
        ]
      },
      "Need": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cancellationRequestId",
          "duty",
          "status",
          "resolvedAt",
          "openOfferCount",
          "project",
          "timeZone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cancellationRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "duty": {
            "$ref": "#/components/schemas/Duty"
          },
          "status": {
            "enum": [
              "OPEN",
              "OPEN_UNFILLED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "resolvedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "openOfferCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "timeZone": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RESOLVED"
                }
              }
            },
            "then": {
              "properties": {
                "resolvedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              }
            },
            "else": {
              "properties": {
                "resolvedAt": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "NeedPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pagination"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "need",
                "myOffer"
              ],
              "properties": {
                "need": {
                  "$ref": "#/components/schemas/Need"
                },
                "myOffer": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Offer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "pageSize",
              "totalItems",
              "totalPages"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "totalItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totalPages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assignmentId",
          "employee",
          "duty",
          "status",
          "createdAt",
          "decidedAt",
          "replacementNeed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "employee": {
            "$ref": "#/components/schemas/Employee"
          },
          "duty": {
            "$ref": "#/components/schemas/Duty"
          },
          "status": {
            "enum": [
              "OPEN",
              "WITHDRAWN",
              "REJECTED",
              "APPROVED",
              "OBSOLETE"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "replacementNeed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "resolvedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "enum": [
                  "OPEN",
                  "OPEN_UNFILLED",
                  "RESOLVED",
                  "CLOSED"
                ]
              },
              "resolvedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "WorkItems": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cancellationRequests",
          "replacementOffers"
        ],
        "properties": {
          "cancellationRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cancellation"
            }
          },
          "replacementOffers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          }
        }
      }
    }
  }
}
