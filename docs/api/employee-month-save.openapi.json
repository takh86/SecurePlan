        {
          "name": "employeeId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getEmployeeMonth",
        "responses": {
          "200": {
            "description": "Committed result or consistent projection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeMonthRead"
                }
              }
            }
          },
          "400": {
            "description": "Existing problem+json contract; no-store; no sensitive details."
          },
          "401": {
            "description": "Existing problem+json contract; no-store; no sensitive details."
          },
          "403": {
            "description": "Existing problem+json contract; no-store; no sensitive details."
