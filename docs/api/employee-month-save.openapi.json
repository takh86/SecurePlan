{
  "openapi": "3.1.0",
  "info": {
    "title": "SecurePlan A2 Employee-Month Save",
    "version": "A2-GATE-1",
    "description": "Adopted 2026-11-03 per issue #88 comment 6600906336, PR #94 c066ff4. Backend implementation contract, not release certification. Existing A1 and INITIAL_PUBLISH contracts unchanged. See employee-month-save.md for precedence, canonical tuples, full-month/date constraints and recovery."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/monthly-plans/{planId}/employee-months/{employeeId}": {
      "parameters": [
